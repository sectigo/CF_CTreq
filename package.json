{
  "name": "cf_ctreq",
  "version": "1.5.0",
  "private": true,
  "description": "Cloudflare Snippet that rejects Certificate Transparency add-chain and add-pre-chain requests at the edge when the log would reject them anyway",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "terser cf_ctreq.js --config-file terser.config.json --output cf_ctreq.min.js",
    "test": "node --test test/cf_ctreq.test.js",
    "test:minified": "CTREQ_MINIFIED=1 node --test test/cf_ctreq.test.js",
    "test:differential": "node test/differential/run.mjs",
    "test:replay": "node test/differential/run.mjs --replay"
  },
  "devDependencies": {
    "terser": "5.51.2"
  }
}
